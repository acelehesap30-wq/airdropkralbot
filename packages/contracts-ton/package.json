{
  "name": "@airdropkral/contracts-ton",
  "version": "1.0.0",
  "private": true,
  "description": "NXT Token — TON Jetton (TEP-74/89) smart contracts for AirdropKral Nexus",
  "scripts": {
    "build": "npx blueprint build",
    "test": "jest",
    "deploy:testnet": "npx blueprint run deployJettonMinter --testnet",
    "deploy:mainnet": "npx blueprint run deployJettonMinter --mainnet --tonconnect",
    "mint:testnet": "npx blueprint run mint --testnet",
    "mint:mainnet": "npx blueprint run mint --mainnet --tonconnect"
  },
  "devDependencies": {
    "@ton/blueprint": "^0.44.0",
    "@ton/core": "^0.63.0",
    "@ton/crypto": "^3.3.0",
    "@ton/sandbox": "^0.41.0",
    "@ton/test-utils": "^0.12.0",
    "@ton/ton": "^16.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
