# TON Jetton Deployment Config
# Copy to .env and fill in values

# TonCenter API key (get from https://toncenter.com)
TONCENTER_API_KEY=

# After deploy: minter contract address
NXT_JETTON_MINTER=

# Admin wallet mnemonic (24 words) — KEEP SECRET
# Only needed for CLI deployment, not TonConnect
ADMIN_MNEMONIC=
